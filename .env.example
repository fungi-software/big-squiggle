# Leave these unset to run against the Firebase emulator suite (npm run emulators).
# Fill them in from the Firebase console to point at a real project.
# None of these are secrets — a web app ships them to the browser, and the security
# rules in database.rules.json are what actually protect the data.
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_DATABASE_URL=
VITE_FB_PROJECT_ID=
VITE_FB_APP_ID=

# Force the emulator even when the values above are filled in.
VITE_USE_EMULATOR=false
