{
  "name": "big-squiggle",
  "version": "0.1.0",
  "description": "A party game for a video call: everyone holds part of a sequence of shapes nobody can describe.",
  "license": "MIT",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:emulator": "firebase emulators:exec --project demo-big-squiggle --only auth,database \"playwright test\"",
    "emulators": "firebase emulators:start --project demo-big-squiggle",
    "test:rules": "firebase emulators:exec --project demo-big-squiggle --only database \"vitest run tests/rules.test.ts\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fungi-software/big-squiggle.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/fungi-software/big-squiggle/issues"
  },
  "homepage": "https://github.com/fungi-software/big-squiggle#readme",
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.2",
    "firebase-tools": "^15.29.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "private": true,
  "dependencies": {
    "firebase": "^12.19.0",
    "posthog-js": "^1.446.0"
  }
}
