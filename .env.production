# Committed on purpose. A Firebase web config is public by design — it ships inside the
# bundle to every visitor already. What protects the data is database.rules.json.
# Keeping it here means any build, on any machine or CI runner, produces a bundle that
# points at the real project instead of silently falling back to the local emulator.
VITE_FB_API_KEY=AIzaSyD-vL8efmhEI9NceMLAi5lgY-celQOGrwo
VITE_FB_AUTH_DOMAIN=big-squiggle.firebaseapp.com
VITE_FB_DATABASE_URL=https://big-squiggle-default-rtdb.firebaseio.com
VITE_FB_PROJECT_ID=big-squiggle
VITE_FB_APP_ID=1:467950394750:web:15c8d0b73eb72a505e672f

# PostHog project key: public, ships in the bundle like the Firebase config above.
VITE_POSTHOG_KEY=phc_srdpTueM2AfYvGqmW53tmjneMKdFKavnkhzm5dAE8TsE
VITE_POSTHOG_HOST=https://us.i.posthog.com
